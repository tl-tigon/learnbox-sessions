# Where data lives. "memory" keeps everything in the dev server's memory (lost on restart).
STORE=memory
# DYNAMODB_TABLE_NAME=LiveAudience-dev
# AWS_REGION=ap-south-1

# Sign-in. "dev" accepts any email with no password, and only outside production.
AUTH_MODE=dev
# NEXT_PUBLIC_COGNITO_USER_POOL_ID=
# NEXT_PUBLIC_COGNITO_CLIENT_ID=
# NEXT_PUBLIC_COGNITO_DOMAIN=

# Payments for Pro, through PayU. With no keys, development uses a stand-in payment page and
# production has payments off. PAYU_ENV=live takes real money; anything else uses PayU's test site.
# PAYU_ENV=standin uses the stand-in page in development even with keys set (the browser walk needs it).
# PAYU_KEY=
# PAYU_SALT=
# PAYU_ENV=test
# This site's address, for the link PayU sends the buyer back to. Needed behind a proxy.
# SITE_URL=https://sessions.learnbox.one

# Live push (AppSync Events). Leave unset to poll.
# NEXT_PUBLIC_EVENTS_HTTP_DOMAIN=xxxx.appsync-api.ap-south-1.amazonaws.com
# NEXT_PUBLIC_EVENTS_REALTIME_DOMAIN=xxxx.appsync-realtime-api.ap-south-1.amazonaws.com
# NEXT_PUBLIC_EVENTS_API_KEY=
